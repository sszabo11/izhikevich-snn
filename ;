use anyhow::Result;
use snn_2::{izhikevich::Izhikevich, plot::plot_izhikievich, plt::Plt};

fn main() -> Result<()> {
    let n_neurons = 10;
    let n_conns = 5;
    let threshold = 30.0;
    let a = 0.02;
    let b = 0.2;
    let c = -65.0;
    let d = 8.0;

    let mut model = Izhikevich::new(n_neurons, n_conns, threshold, a, b, c, d);

    let output = model.run(400 as f32);

    //Plt::spikes("spikes.png", output)?;

    let rt = plot_izhikievich(&output, "charts/spikes2.png").unwrap();
    Ok(())
}
